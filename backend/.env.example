# ─── App ──────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# ─── Paths (all on E:) ────────────────────────
DATA_ROOT=E:/IDE/Eternal-Mind/data
MODEL_ROOT=E:/IDE/Eternal-Mind/models
SQLITE_PATH=E:/IDE/Eternal-Mind/data/database/eternal_mind.db
CHROMA_PATH=E:/IDE/Eternal-Mind/data/chroma

# ─── LLM (Stage 1 — fill after benchmarking) ──
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0.4
LLM_CONTEXT_LENGTH=

# ─── Embeddings (Stage 3 — placeholder) ───────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Speech (Stage 6 — placeholder) ───────────
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_ENGINE=piper
TTS_VOICE=

# ─── Logging ──────────────────────────────────
LOG_LEVEL=INFO
STORE_MESSAGE_BODIES_IN_LOGS=false